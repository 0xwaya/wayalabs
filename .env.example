# Contact delivery (Resend). Both keys are required before /api/contact
# will accept an inquiry. The from address must be a verified Resend sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=admin@wayalabs.com

# Lead engine CRM (Supabase). Optional at boot: if unset, email still works
# and CRM filing is skipped. Create a dedicated "wayalabs" project (do not
# reuse Urban Stone or Queen City Soundboard), apply supabase/migrations/, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Weekday jobs: /api/leads/source (12:00 UTC) and /api/leads/digest (13:00 UTC).
# Min 16 chars. Jobs email the operator only — never the lead or candidate.
CRON_SECRET=

# Outbound sourcer toggles (default on). Set to 0/false/off to disable.
LEAD_SOURCE_SBA=
LEAD_SOURCE_AI_INTENT=
