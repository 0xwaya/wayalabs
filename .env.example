# Contact delivery (Resend). Both keys are required before /api/contact
# will accept an inquiry. The from address must be a verified Resend sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=admin@wayalabs.com

# Lead engine + AI Factory DB (Neon project "wayalabs", id quiet-cherry-92183008).
# Use the pooled connection string from the Neon console. Server-only — never
# expose to the browser. CRM filing + Factory Phase 1 both use this.
DATABASE_URL=

# Weekday jobs: /api/leads/source (12:00 UTC) and /api/leads/digest (13:00 UTC).
# Min 16 chars. Jobs email the operator only — never the lead or candidate.
CRON_SECRET=

# Outbound sourcer toggles (default on). Set to 0/false/off to disable.
LEAD_SOURCE_SBA=
LEAD_SOURCE_AI_INTENT=

# AI Factory mode (Phase 1+). Default sandbox keeps the client tick sim.
FACTORY_MODE=sandbox

# Stripe webhook (ai-factory). Required for POST /api/hooks/stripe.
STRIPE_WEBHOOK_SECRET=
