# Contact delivery (Resend). Both keys are required before /api/contact
# will accept an inquiry. The from address must be a verified Resend sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=admin@wayalabs.com

# Lead engine CRM (Supabase). Optional at boot: if unset, email still works
# and CRM filing is skipped. Create a dedicated "wayalabs" project (do not
# reuse Urban Stone or Queen City Soundboard), apply
# supabase/migrations/20261124180000_lead_engine.sql, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Weekday lead digest at /api/leads/digest (Vercel schedule). Min 16 chars.
# Digest emails the operator only — never the lead.
CRON_SECRET=
